{
  "name": "klimwoordenboek",
  "description": "Klimwoordenboek Frans & Engels",
  "scripts": {
    "dev": "npm-run-all copy:* sass",
    "copy:throttle" : "cp -uv node_modules/es-toolkit/dist/function/throttle.mjs js/es-toolkit/throttle.mjs",
    "copy:debounce" : "cp -uv node_modules/es-toolkit/dist/function/debounce.mjs js/es-toolkit/debounce.mjs",
    "sass": "sass --style=compressed --no-charset scss:.",
    "watch": "sass --style=compressed --no-charset --watch scss:."
  },
  "dependencies": {
    "es-toolkit": "^1.51.0"
  }
}
